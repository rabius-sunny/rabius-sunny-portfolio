---
import Container from './Container.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<Container>
  <div class='flex items-center gap-4 mb-8'>
    <div class='h-1 w-12 bg-gradient-to-r from-heading to-main rounded-full'></div>
    <h1 class='text-3xl md:text-4xl font-bold uppercase text-white tracking-wider'>
      <span class='text-transparent bg-clip-text bg-gradient-to-r from-white to-white/60'>
        {title}
      </span>
    </h1>
    <div class='h-[1px] flex-1 bg-gradient-to-r from-white/10 to-transparent'></div>
  </div>
</Container>
