---
import { strokeIcons } from '../data/iconPaths'
import { skillIconSvg } from '../data/skillIcons'

interface Props {
  name: string
  variant?: 'stroke' | 'fill'
  class?: string
}

const { name, variant = 'stroke', class: cls = 'size-4' } = Astro.props
const inner =
  variant === 'stroke' ? (strokeIcons[name] ?? '') : (skillIconSvg[name] ?? '')
---

{variant === 'stroke' ? (
  <svg
    xmlns='http://www.w3.org/2000/svg'
    viewBox='0 0 24 24'
    fill='none'
    stroke='currentColor'
    stroke-width='2'
    stroke-linecap='round'
    stroke-linejoin='round'
    class={cls}
    aria-hidden='true'
    set:html={inner}
  />
) : (
  <svg
    viewBox='0 0 32 32'
    fill='none'
    class={cls}
    aria-hidden='true'
    set:html={inner}
  />
)}
