---
import Container from '../components/Container.astro'
import Icon from '../components/Icon.astro'
import Base from '../layouts/Base.astro'
---

<Base
  title='Page not found'
  description='The page you are looking for does not exist.'
  canonical='https://rabiussunny.com/404'
>
  <Container>
    <div class='max-w-md mx-auto min-h-[70vh] pt-24 flex flex-col items-center justify-center text-center gap-6'>
      <p class='text-7xl sm:text-8xl font-black tracking-tight text-white'>
        4<span class='text-[#00d8f6]'>0</span>4
      </p>
      <h1 class='text-xl sm:text-2xl font-bold text-white'>Page not found</h1>
      <p class='text-slate-400 text-sm sm:text-base leading-relaxed'>
        The page you are looking for does not exist or has been moved.
      </p>
      <a
        href='/'
        class='inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#00c5e8] hover:bg-[#38bdf8] text-[#011427] font-semibold text-sm transition-all duration-300 shadow-lg shadow-[#00c5e8]/25 hover:shadow-[#00c5e8]/40 hover:-translate-y-0.5'
      >
        <span>Back to home</span>
        <Icon name='arrow-right' class='size-4' />
      </a>
    </div>
  </Container>
</Base>
