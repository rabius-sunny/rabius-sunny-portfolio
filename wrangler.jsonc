  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    "CONTACT_TO": "rabiussunny10@gmail.com",
    "CONTACT_FROM": "contact@rabiussunny.com"
  }
}
